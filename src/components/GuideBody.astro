---
// Rich, unique long-form guide body for pSEO pages. Renders below the
// interactive playground so each page carries substantial standalone content
// (the fix for "Crawled - currently not indexed"). Driven by the optional
// `guide` object on a seoLayouts.json entry; pages without it are unaffected.
interface CodeBlock {
  label: string;
  lang?: 'html' | 'css';
  src: string;
}
interface Section {
  h2: string;
  body: string[];
  code?: CodeBlock[];
}
interface FaqItem {
  q: string;
  a: string;
}
export interface Guide {
  datePublished?: string;
  dateModified?: string;
  sections: Section[];
  faq?: FaqItem[];
}

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;

// Server-side syntax highlighting mirroring the app's code exporter
// (src/scripts/flexr.js): tags → sky, attributes/properties → violet/sky,
// strings/values → emerald.
const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const hlHtml = (src: string) =>
  escapeHtml(src).replace(
    /(&lt;\/?[\w-]+|\/?&gt;)|([\w-]+)(?==)|("[^"]*")/g,
    (_m, tag, attr, str) => {
      if (tag) return `<span class="text-sky-400">${tag}</span>`;
      if (attr) return `<span class="text-violet-400">${attr}</span>`;
      return `<span class="text-emerald-400">${str}</span>`;
    }
  );

const hlCss = (src: string) =>
  escapeHtml(src).replace(
    /(^[.#][\w-]+)|([\w-]+)(?=:)|(:[^;\n]+;)/gm,
    (_m, sel, prop, val) => {
      if (sel) return `<span class="text-violet-400">${sel}</span>`;
      if (prop) return `<span class="text-sky-400">${prop}</span>`;
      return `<span class="text-emerald-400">${val}</span>`;
    }
  );

const hl = (b: CodeBlock) => (b.lang === 'css' ? hlCss(b.src) : hlHtml(b.src));

const preClass =
  'mt-3 max-w-3xl overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-950/70 p-4 text-[13px] leading-relaxed text-zinc-300';
---

<div class="seo-prose mx-auto w-full max-w-7xl px-4 pt-2 pb-8 lg:px-6">
  {
    guide.sections.map((section) => (
      <section class="mb-9">
        <h2 class="text-xl font-light tracking-tight text-zinc-100 sm:text-2xl">{section.h2}</h2>
        {section.body.map((html) => (
          <p class="mt-3 max-w-3xl text-sm leading-relaxed font-light text-zinc-400" set:html={html} />
        ))}
        {section.code?.map((block) => (
          <figure class="mt-3">
            <figcaption class="mb-1 font-mono text-[11px] tracking-wide text-zinc-500 uppercase">
              {block.label}
            </figcaption>
            <pre class={preClass}><code class="font-mono" set:html={hl(block)} /></pre>
          </figure>
        ))}
      </section>
    ))
  }

  {
    guide.faq && guide.faq.length > 0 && (
      <section class="mb-2">
        <h2 class="text-xl font-light tracking-tight text-zinc-100 sm:text-2xl">
          Frequently asked questions
        </h2>
        <dl class="mt-3 max-w-3xl divide-y divide-zinc-800/70 border-t border-zinc-800/70">
          {guide.faq.map((item) => (
            <div class="py-4">
              <dt class="text-sm font-semibold text-zinc-200">{item.q}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed font-light text-zinc-400">{item.a}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</div>

<style>
  .seo-prose :global(code) {
    border-radius: 0.25rem;
    background-color: rgb(39 39 42 / 0.7);
    padding: 0.0625rem 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-indigo-300);
  }
  .seo-prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }
  .seo-prose :global(strong) {
    color: var(--color-zinc-200);
    font-weight: 600;
  }
</style>
