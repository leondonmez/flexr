---
import '../styles/global.css';
import NetworkFooter from '../components/NetworkFooter.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Flexr — CSS Flexbox & Grid Playground | flexr.dev',
  description =
    'Point-and-click CSS Flexbox and Grid layout laboratory. Build layouts visually and copy production-ready Tailwind CSS or vanilla CSS instantly. 100% client-side — no servers, no tracking.',
  // Pages pass an explicit canonical; anything that doesn't gets one derived
  // from the configured site URL so no page ships without the tag.
  canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://flexr.dev').href,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%236366f1'/%3E%3Crect x='6' y='6' width='9' height='20' rx='2' fill='white' opacity='.9'/%3E%3Crect x='17' y='6' width='9' height='9' rx='2' fill='white' opacity='.6'/%3E%3Crect x='17' y='17' width='9' height='9' rx='2' fill='white' opacity='.75'/%3E%3C/svg%3E"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body class="flex min-h-full flex-col text-zinc-100 antialiased">
    <header class="sticky top-0 z-40 border-b border-zinc-800/70 bg-zinc-950/80 backdrop-blur">
      <div class="mx-auto flex h-14 w-full max-w-7xl items-center justify-between px-4 lg:px-6">
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="grid h-7 w-7 place-items-center rounded-lg bg-linear-to-br from-indigo-500 to-violet-600 text-sm font-black text-white shadow-lg shadow-indigo-500/30"
            >F</span
          >
          <span class="text-lg font-bold tracking-tight">flexr<span class="text-indigo-400">.dev</span></span>
        </a>
        <p class="hidden text-xs text-zinc-500 sm:block">
          Flexbox &amp; Grid layout laboratory — 100% client-side
        </p>
      </div>
    </header>

    <main class="w-full flex-1">
      <slot />
    </main>

    <NetworkFooter />
  </body>
</html>
