---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Flexr — CSS Flexbox & Grid Playground | flexr.dev',
  description =
    'Point-and-click CSS Flexbox and Grid layout laboratory. Build layouts visually and copy production-ready Tailwind CSS or vanilla CSS instantly. 100% client-side — no servers, no tracking.',
  // Pages pass an explicit canonical; anything that doesn't gets one derived
  // from the configured site URL so no page ships without the tag.
  canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://flexr.dev').href,
} = Astro.props;

const network = [
  { name: 'Vibsio', href: 'https://vibs.io', hint: 'The studio behind Flexr' },
  { name: 'SandboxMax', href: 'https://sandboxmax.com', hint: 'Client-side developer utilities' },
  { name: 'CronCrunch', href: 'https://croncrunch.dev', hint: 'Cron expression tools' },
  { name: 'MockDock', href: 'https://mockdock.dev', hint: 'Mock API sandbox' },
];
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%236366f1'/%3E%3Crect x='6' y='6' width='9' height='20' rx='2' fill='white' opacity='.9'/%3E%3Crect x='17' y='6' width='9' height='9' rx='2' fill='white' opacity='.6'/%3E%3Crect x='17' y='17' width='9' height='9' rx='2' fill='white' opacity='.75'/%3E%3C/svg%3E"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body class="flex min-h-full flex-col text-zinc-100 antialiased">
    <header class="sticky top-0 z-40 border-b border-zinc-800/70 bg-zinc-950/80 backdrop-blur">
      <div class="mx-auto flex h-14 w-full max-w-7xl items-center justify-between px-4 lg:px-6">
        <a href="/" class="flex items-center gap-2.5">
          <span
            class="grid h-7 w-7 place-items-center rounded-lg bg-linear-to-br from-indigo-500 to-violet-600 text-sm font-black text-white shadow-lg shadow-indigo-500/30"
            >F</span
          >
          <span class="text-lg font-bold tracking-tight">flexr<span class="text-indigo-400">.dev</span></span>
        </a>
        <p class="hidden text-xs text-zinc-500 sm:block">
          Flexbox &amp; Grid layout laboratory — 100% client-side
        </p>
      </div>
    </header>

    <main class="w-full flex-1">
      <slot />
    </main>

    <footer class="border-t border-zinc-800/70">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-4 px-4 py-6 lg:px-6">
        <nav aria-label="Vibsio tool network" class="flex flex-wrap items-center gap-x-5 gap-y-2">
          <span class="text-[11px] font-semibold tracking-widest text-zinc-600 uppercase">
            More from Vibsio
          </span>
          {
            network.map((tool) => (
              <a
                href={tool.href}
                title={tool.hint}
                class="text-xs text-zinc-500 transition-colors hover:text-indigo-300"
              >
                {tool.name}
              </a>
            ))
          }
        </nav>
        <div class="flex flex-col items-start justify-between gap-2 text-xs text-zinc-500 sm:flex-row sm:items-center">
          <p>&copy; 2026 <a href="https://vibs.io" class="text-zinc-400 transition-colors hover:text-indigo-300">Vibsio LLC</a> &middot; flexr.dev</p>
          <p>No servers. No tracking. Your layouts never leave the browser.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
