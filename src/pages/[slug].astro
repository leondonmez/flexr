---
// Programmatic SEO pages: one static route per entry in seoLayouts.json,
// generated at build time. Each page ships unique metadata, a crawlable
// copy block, and a JSON state island that pre-configures the laboratory.
import Layout from '../layouts/Layout.astro';
import FlexrApp from '../components/FlexrApp.astro';
import RelatedLayouts from '../components/RelatedLayouts.astro';
import layouts from '../data/seoLayouts.json';

export function getStaticPaths() {
  return layouts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;

// Optional per-page long-form SEO copy (present on select entries only).
const supplementalSections =
  (entry as {
    supplementalSections?: Array<{ h2: string; paragraphs: string[]; code?: string }>;
  }).supplementalSections ?? [];
---

<Layout
  title={entry.title}
  description={entry.metaDescription}
  canonical={`https://flexr.dev/${entry.slug}`}
>
  <section class="mx-auto w-full max-w-7xl px-4 pt-8 pb-1 lg:px-6">
    <p class="mb-2 text-[11px] font-semibold tracking-widest text-indigo-400 uppercase">
      Layout Recipe
    </p>
    <h1 class="text-2xl font-light tracking-tight text-zinc-100 sm:text-3xl">
      {entry.h1}
    </h1>
    <p class="mt-2.5 max-w-3xl text-sm leading-relaxed font-light text-zinc-400">
      {entry.explanationText}
    </p>
    <p class="mt-2 text-xs text-zinc-600">
      The playground below is pre-configured with this exact layout — tweak any control to
      explore, then copy the Tailwind or vanilla CSS from the exporter.
    </p>
  </section>

  <script type="application/json" id="flexr-initial-state" set:html={JSON.stringify(entry.initialState)} />

  <FlexrApp />

  {
    supplementalSections.map((section) => (
      <section class="seo-prose mx-auto w-full max-w-7xl px-4 pt-2 pb-8 lg:px-6">
        <h2 class="text-xl font-light tracking-tight text-zinc-100 sm:text-2xl">{section.h2}</h2>
        {section.paragraphs.map((paragraph) => (
          <p
            class="mt-3 max-w-3xl text-sm leading-relaxed font-light text-zinc-400"
            set:html={paragraph}
          />
        ))}
        {section.code && (
          <pre class="mt-4 max-w-3xl overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-950/70 p-4 text-[13px] leading-relaxed text-zinc-300"><code class="font-mono">{section.code}</code></pre>
        )}
      </section>
    ))
  }

  <RelatedLayouts currentSlug={entry.slug} />
</Layout>
